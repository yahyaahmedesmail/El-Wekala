# Local PostgreSQL (pgAdmin) — replace YOUR_PASSWORD with your postgres user password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/el_wekala?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

MIN_ORDER_AMOUNT=100
NEXT_PUBLIC_MIN_ORDER_AMOUNT=100

# Agency contact (optional — shown on /about)
NEXT_PUBLIC_AGENCY_PHONE=
NEXT_PUBLIC_AGENCY_EMAIL=

# Email (SMTP) — required to send real emails. Without these, the app shows a
# clickable "dev link" on the page and prints the URL in the server terminal.
#
# Gmail example (use an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="الوكالة <your@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="الوكالة <noreply@el-wekala.com>"

# WhatsApp (Meta Cloud API) — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONES=01001234567
WHATSAPP_API_VERSION=v21.0
